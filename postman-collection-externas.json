    {
      "name": "Câmara dos Deputados",
      "item": [
        {
          "name": "Listar Deputados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{camaraBaseUrl}}/deputados?itens=100&pagina=1&ordem=ASC&ordenarPor=nome",
              "host": ["{{camaraBaseUrl}}"],
              "path": ["deputados"],
              "query": [
                {
                  "key": "itens",
                  "value": "100",
                  "description": "Itens por página"
                },
                {
                  "key": "pagina",
                  "value": "1",
                  "description": "Número da página"
                },
                {
                  "key": "ordem",
                  "value": "ASC",
                  "description": "Ordem (ASC ou DESC)"
                },
                {
                  "key": "ordenarPor",
                  "value": "nome",
                  "description": "Campo para ordenação (nome, id, etc)"
                }
              ]
            },
            "description": "Lista todos os deputados da Câmara dos Deputados com paginação"
          }
        },
        {
          "name": "Buscar Deputado por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{camaraBaseUrl}}/deputados/:id",
              "host": ["{{camaraBaseUrl}}"],
              "path": ["deputados", ":id"],
