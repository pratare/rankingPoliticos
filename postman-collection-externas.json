{
  "info": {
    "name": "APIs Externas - Parlamentares",
    "description": "Collection para testar as APIs externas da Câmara dos Deputados e Senado Federal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "camaraBaseUrl",
      "value": "https://dadosabertos.camara.leg.br/api/v2",
      "type": "string"
    },
    {
